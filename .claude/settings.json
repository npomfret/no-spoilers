{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(~/.appstoreconnect/private_keys/**)",
      "Read(~/projects/appstoreconnect-bot/tmp/curl.txt)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(sudo *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git fetch *",
      "git pull *",
      "git push *",
      "git ls-remote *",
      "git clone *",
      "gh *",
      "python3 scripts/teamcity.py *",
      "ssh *",
      "scp *",
      "rsync *",
      "npm run deploy*",
      "./scripts/verify-*.sh*"
    ],
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/Library/Caches",
        "~/Library/Developer/Xcode/DerivedData",
        "/var/folders"
      ],
      "allowRead": [
        "~/.appstoreconnect/private_keys",
        "~/projects/appstoreconnect-bot/tmp/curl.txt"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "task-files@npomfret": true,
    "teamcity@npomfret": true
  }
}
