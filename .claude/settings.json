{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch",
      "mcp__webstorm",
      "mcp__xcode",
      "mcp__plugin_playwright_playwright"
    ],
    "deny": [
      "mcp__webstorm__execute_terminal_command",
      "mcp__webstorm__execute_run_configuration",
      "mcp__webstorm__execute_tool",
      "mcp__webstorm__run_inspection_kts",
      "mcp__webstorm__build_project",
      "mcp__webstorm__apply_patch",
      "mcp__webstorm__create_new_file",
      "mcp__webstorm__reformat_file",
      "mcp__xcode__RunCodeSnippet",
      "mcp__xcode__InvokeDebuggerCommand",
      "Read(~/.appstoreconnect/private_keys/**)",
      "Read(~/projects/apple-appstoreconnect-api/tmp/curl.txt)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(sudo *)"
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "task-files@npomfret": true,
    "teamcity@npomfret": true,
    "webstorm@npomfret": true,
    "auditing@npomfret": true,
    "typesafe@typesafe-ai": false,
    "ios-ui-testing@npomfret": true,
    "scripting@npomfret": true,
    "apple-hig@npomfret": true,
    "web-factoring@npomfret": false,
    "frontend-design@claude-plugins-official": false,
    "browser-testing@npomfret": false,
    "database@npomfret": false,
    "typescript-lsp@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "browser@npomfret": false,
    "coding@npomfret": true,
    "http@npomfret": true,
    "testing@npomfret": true,
    "ui@npomfret": true,
    "workflow@npomfret": true,
    "localization@npomfret": true
  },
  "enabledMcpjsonServers": ["webstorm", "xcode"],
  "extraKnownMarketplaces": {
    "npomfret": {
      "source": {
        "source": "github",
        "repo": "npomfret/agent-standards"
      },
      "autoUpdate": true
    }
  }
}
